---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">HELLO, I'M</p>
      <h1>Michael</h1>
      <h2>Software Developer</h2>

      <p>
        I'm a backend-focused software engineer who enjoys building reliable
        applications, APIs and tools.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">
          View my projects
        </a>
        <a class="button button-secondary" href="/cv.pdf">
          View CV
        </a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/cv_headshot.jpg" alt="Michael" />
    </div>
  </section>

  <section class="featured">
    <div class="project-top">
      <div class="project-details">
        <p class="eyebrow">FEATURED PROJECT</p>
        <h2>Incidetective</h2>
        <p>
          An incident investigation tool focused on finding root causes rather
          than just symptoms.
        </p>
        <a href="/projects/incidetective/">View project</a>
      </div>
    </div>
  </section>
  <section class="tech-stack" aria-label="Technical skills">
    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="m7 9 3 3-3 3" />
          <path d="M13 15h4" />
        </svg>
      </span>
      <h3>Backend</h3>
      <p>TypeScript · Node.js · Fastify</p>
    </div>

    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <ellipse cx="12" cy="5" rx="8" ry="3" />
          <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
          <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
        </svg>
      </span>
      <h3>Database</h3>
      <p>PostgreSQL · MongoDB · Neo4j</p>
    </div>

    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
          <path d="M14 5h7v5" />
          <path d="M21 5 10 16" />
        </svg>
      </span>
      <h3>Infrastructure</h3>
      <p>Terraform · GCP · Linux</p>
    </div>
  </section>

  <section class="writings">
    <div class="blog-about">
      <p class="eyebrow">WRITING</p>
      <h2>Notes & thoughts</h2>
      <p>Software, projects, and whatever else I'm curious about.</p>
    </div>

    <div class="blog-empty">
      <h3>More to come.</h3>
      <p>
        I plan to share what I'm learning, building, and experimenting with
        here.
      </p>
    </div>
  </section>
</BaseLayout>
