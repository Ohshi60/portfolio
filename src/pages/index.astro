---
import "../styles/global.css";
import "@fontsource/dm-sans";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Personal portfolio of a software engineer"
    />
    <title>Michael Søby | Developer</title>

    <script is:inline>
      (() => {
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem("theme");
        } catch {
          // Storage may be unavailable.
        }

        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        document.documentElement.dataset.theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : prefersDark
              ? "dark"
              : "light";
      })();
    </script>
  </head>
  <body>
    <header>
      <a href="/" class="site-logo" aria-label="Michael, home">
        <img src="/images/cv_headshot.jpg" alt="" />
      </a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current="page">
          Home
        </a>
        <a href="/">Projects</a>
        <a href="/">Writing</a>
      </nav>
      <ThemeToggle />
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">HELLO, I'M</p>
          <h1>Michael</h1>
          <h2>Software Developer</h2>

          <p>
            I'm a backend-focused software engineer who enjoys building reliable
            applications, APIs and tools.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/projects/">
              View my projects
            </a>
            <a class="button button-secondary" href="/cv.pdf">
              View CV
            </a>
          </div>
        </div>
        <div class="hero-image">
          <img src="/images/cv_headshot.jpg" alt="Michael" />
        </div>
      </section>

      <section class="featured">
        <div class="project-top">
          <div class="project-details">
            <p class="eyebrow">FEATURED PROJECT</p>
            <h2>Incidetective</h2>
            <p>
              An incident investigation tool focused on finding root causes
              rather than just symptoms.
            </p>
            <a href="/projects/opspilot/">View project</a>
          </div>
          <div class="project-image">
            <p>Image goes here</p>
          </div>
        </div>
      </section>
      <section class="tech-stack" aria-label="Technical skills">
        <div class="feat-skills">
          <span class="skill-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="m7 9 3 3-3 3" />
              <path d="M13 15h4" />
            </svg>
          </span>
          <h3>Backend</h3>
          <p>TypeScript · Node.js · Fastify</p>
        </div>

        <div class="feat-skills">
          <span class="skill-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <ellipse cx="12" cy="5" rx="8" ry="3" />
              <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
              <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
            </svg>
          </span>
          <h3>Database</h3>
          <p>PostgreSQL · MongoDB · Neo4j</p>
        </div>

        <div class="feat-skills">
          <span class="skill-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
              <path d="M14 5h7v5" />
              <path d="M21 5 10 16" />
            </svg>
          </span>
          <h3>Infrastructure</h3>
          <p>Terraform · GCP · Linux</p>
        </div>
      </section>

      <section class="writings">
        <div class="blog-about">
          <h2>Latest writing</h2>
          <p>Notes on software, music and other interests</p>
          <a href="/blog">View all posts</a>
        </div>
        <div class="blog-latest">
          <article class="blog-summary">
            <div class="blog-preview-image">Image placeholder</div>
            <h3>Title</h3>
            <time datetime="22-11-2222">22-11-2222</time>
          </article>
          <article class="blog-summary">
            <div class="blog-preview-image">Image placeholder</div>
            <h3>Title</h3>
            <time datetime="22-11-2222">22-11-2222</time>
          </article>
          <article class="blog-summary">
            <div class="blog-preview-image">Image placeholder</div>
            <h3>Title</h3>
            <time datetime="22-11-2222">22-11-2222</time>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-name">© {new Date().getFullYear()} Michael</p>

      <nav class="footer-links" aria-label="Social links">
        <a
          href="https://github.com/Ohshi60"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.32-3.75-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.12-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.23-5.1 5.51.4.34.76 1.01.76 2.04v3.03c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"
            />
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href="https://www.linkedin.com/in/mssoeby/"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.97V9.22h2.96v9.53ZM6.45 7.92a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.83h-2.95v-4.64c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.5V9.22h2.84v1.3h.04c.4-.75 1.36-1.54 2.8-1.54 3 0 3.57 1.98 3.57 4.55v5.22Z"
            />
          </svg>
          <span>LinkedIn</span>
        </a>

        <a href="mailto:mssoeby60@gmail.com">Email</a>
      </nav>
    </footer>
  </body>
</html>
