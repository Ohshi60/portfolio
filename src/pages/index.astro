---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTerminal from "../components/HeroTerminal.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">HELLO, I'M</p>
      <h1>Michael</h1>
      <h2>Software Developer</h2>

      <p>
        I'm a backend-focused software engineer who enjoys building reliable
        applications, APIs and tools.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">
          View my projects
        </a>
      </div>
      <p class="hero-aside">
        Outside work I build split keyboards, tinker with my homelab and dig for
        records.{" "}
        <a class="link-arrow" href="/about/">
          More about me <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
    <HeroTerminal />
  </section>

  <FeaturedProject />
  <section class="tech-stack" aria-label="Technical skills">
    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="m7 9 3 3-3 3" />
          <path d="M13 15h4" />
        </svg>
      </span>
      <h3>Backend</h3>
      <p>TypeScript · Node.js · Fastify</p>
    </div>

    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <ellipse cx="12" cy="5" rx="8" ry="3" />
          <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
          <path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
        </svg>
      </span>
      <h3>Database</h3>
      <p>PostgreSQL · MongoDB · Neo4j</p>
    </div>

    <div class="feat-skills">
      <span class="skill-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
          <path d="M14 5h7v5" />
          <path d="M21 5 10 16" />
        </svg>
      </span>
      <h3>Infrastructure</h3>
      <p>Terraform · GCP · Linux</p>
    </div>
  </section>
</BaseLayout>
