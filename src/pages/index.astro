---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTerminal from "../components/HeroTerminal.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import nightCityThumb from "../assets/night-city/overview-day.png";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">HELLO, I'M</p>
      <h1>Michael Søby</h1>
      <h2>Backend Engineer</h2>

      <p>
        I build APIs, backend services and the tools around them, and I like
        running them on hardware I can see. Lately that's Incidetective, which
        turns a pile of service logs into evidence-backed hypotheses about what
        broke.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">
          View my projects
        </a>
      </div>
      <p class="hero-aside">
        Outside work I build split keyboards, tinker with my homelab and dig for
        records.{" "}
        <a class="link-arrow" href="/about/">
          More about me <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
    <HeroTerminal />
  </section>

  <FeaturedProject />

  <section class="also-built" aria-labelledby="also-built-title">
    <p class="eyebrow">Also built</p>
    <a href="/projects/night-city-dashboard/" class="also-built-card">
      <div class="also-built-image">
        <Image src={nightCityThumb} alt="" widths={[280, 560]} sizes="280px" />
      </div>
      <div class="also-built-content">
        <h2 id="also-built-title">Night City dashboard</h2>
        <p>
          A Home Assistant dashboard for my apartment, written in plain ES5 so
          it runs on a 2012 iPad mini.
        </p>
        <span class="link-arrow">
          View project <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  </section>
</BaseLayout>
