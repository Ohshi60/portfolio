---
import "../styles/global.css";
import "@fontsource/dm-sans";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import { ClientRouter } from "astro:transitions";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path of the link-preview image under public/; defaults to /og.png. */
  image?: string;
}

const {
  title = "Michael Søby | Backend Engineer",
  description = "Portfolio of Michael Søby, a backend engineer who builds developer tools and self-hosted projects.",
  image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>

    <!-- Link previews (LinkedIn, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Michael Søby" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Set the theme before first paint to avoid a flash. View transitions swap
      in the new page's <html> attributes, which drops data-theme, so the same
      function reruns after every swap.
    -->
    <script is:inline>
      (() => {
        const applyTheme = () => {
          // window.__theme: set by the toggle, survives view transitions even
          // when storage is blocked.
          let savedTheme = window.__theme ?? null;
          try {
            savedTheme = savedTheme ?? localStorage.getItem("theme");
          } catch {
            // Storage may be unavailable.
          }
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          document.documentElement.dataset.theme =
            savedTheme === "light" || savedTheme === "dark"
              ? savedTheme
              : prefersDark
                ? "dark"
                : "light";
        };

        applyTheme();
        if (!window.__themeSwapListener) {
          window.__themeSwapListener = true;
          document.addEventListener("astro:after-swap", applyTheme);
        }
      })();
    </script>
    <ClientRouter />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
